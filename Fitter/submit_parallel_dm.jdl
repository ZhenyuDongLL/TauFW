# ===================================================================
# submit_parallel_dm.jdl: 并行提交多个 DM 作业的描述文件
# ===================================================================

universe              = vanilla
# 指定你的可执行脚本
executable            = run_parallel_createinputs_single.sh

# 定义传递给脚本的参数
# $(DM) 将会从下面的 queue 语句中被替换
# !!! 极端重要：请将下面的路径修改为您的实际绝对路径 !!!
arguments             = $(DM) /afs/cern.ch/user/z/zhdong/CMSSW_14_1_0_pre4/src /afs/cern.ch/user/z/zhdong/CMSSW_14_1_0_pre4/src/TauFW/Fitter/condor_outputs_single/tau_fitter

request_cpus = 4
request_memory = 3000 MB

# 定义日志文件的存放位置
output                = condor_logs/job_$(ClusterId)_$(ProcId).out
error                 = condor_logs/job_$(ClusterId)_$(ProcId).err
log                   = condor_logs/job_$(ClusterId).log

# 请求作业时长。longlunch=2小时, workday=8小时。对于单个DM，2小时应该足够
+JobFlavour           = "workday"

# 关键部分：为列表中的每一项创建一个作业
# Condor 会自动将 DM0, DM1, ... 替换到上面 arguments 中的 $(DM) 位置
queue DM in DM0 DM1 DM10 DM11